{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paribar-backup.schema.json",
  "title": "Paribar backup / import file",
  "type": "object",
  "required": [
    "people"
  ],
  "properties": {
    "app": {
      "const": "paribar",
      "description": "Optional on import"
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "Optional. 2 = adds dob/extra. Files without it still import."
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "meta": {
      "type": "object",
      "properties": {
        "meId": {
          "type": "string",
          "description": "id of the person who is 'Me' — all Bengali terms are relative to them"
        },
        "voiceLang": {
          "enum": [
            "en-IN",
            "bn-IN",
            "hi-IN",
            "en-US"
          ]
        },
        "lastBackup": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nickname": {
            "type": "string",
            "description": "What you call them, e.g. 'Chhoto Mama'"
          },
          "gender": {
            "enum": [
              "m",
              "f",
              "x"
            ],
            "default": "x",
            "description": "Needed for Mama vs Mashi etc."
          },
          "birthYear": {
            "type": "string",
            "description": "Kept in sync with dob so v0.1 still works. Import treats it as dob if dob is missing"
          },
          "phone": {
            "type": "string"
          },
          "whatsapp": {
            "type": "boolean",
            "default": true
          },
          "email": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "metOn": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "notes": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "data:image/jpeg;base64,... (first = main photo)"
            },
            "default": []
          },
          "placeholder": {
            "type": "boolean",
            "description": "Auto-created, e.g. 'Didima' added to place a Mashi-Didima"
          },
          "isMe": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "relationToMe": {
            "type": "object",
            "readOnly": true,
            "description": "COMPUTED on export for readability. Ignored on import — recalculated from relationships.",
            "properties": {
              "bengali": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Bengali script, e.g. মাসতুতো বোন"
              },
              "bengaliRoman": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Romanized, e.g. Mashtuto Bon"
              },
              "english": {
                "type": "string",
                "description": "e.g. Mother's sister's daughter"
              },
              "side": {
                "enum": [
                  "me",
                  "close",
                  "maternal",
                  "paternal",
                  "inlaw",
                  "friend",
                  "unlinked"
                ]
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "e.g. [\"mother\",\"sister\",\"daughter\"]"
              }
            }
          },
          "dob": {
            "type": "string",
            "pattern": "^$|^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "description": "YYYY-MM-DD, YYYY-MM or YYYY. On import also accepts DD/MM/YYYY, '14 Apr 1962', Excel dates"
          },
          "extra": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Unrecognised CSV columns / JSON fields, kept so nothing is lost"
          },
          "calledTerm": {
            "type": "string",
            "description": "The term YOU use (e.g. 'Pishe Dadu'); shown before the app's computed term"
          },
          "termNuance": {
            "type": "string",
            "description": "Bengali nuance for the term (CSV column: bengali_nuance)"
          }
        },
        "additionalProperties": true
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "parent_of",
              "spouse_of",
              "sibling_of",
              "child_of",
              "friend_of"
            ],
            "description": "parent_of: 'from' is the parent of 'to'. spouse_of / sibling_of / friend_of: direction doesn't matter. Also accepted: parent, spouse, married, sibling, child_of (reversed)"
          },
          "from": {
            "type": "string",
            "description": "person id (or a unique name)"
          },
          "to": {
            "type": "string",
            "description": "person id (or a unique name)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "married",
              "separated",
              "widowed"
            ],
            "description": "spouse_of only"
          },
          "marriedYear": {
            "type": "string",
            "description": "spouse_of only, e.g. 1985"
          },
          "marriedOn": {
            "type": "string",
            "format": "date",
            "description": "spouse_of only, full wedding date YYYY-MM-DD (gives an anniversary under Dates)"
          },
          "kind": {
            "enum": [
              "friend",
              "colleague",
              "neighbor",
              "classmate"
            ],
            "description": "friend_of only (default friend)"
          }
        }
      }
    },
    "visits": {
      "type": "array",
      "description": "Visit log (app v1.0+). Optional.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD"
          },
          "place": {
            "type": "string"
          },
          "peopleIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "person ids who were there"
          },
          "notes": {
            "type": "string"
          },
          "giftsGiven": {
            "type": "string"
          },
          "giftsReceived": {
            "type": "string"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "data: URLs (JPEG)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    }
  }
}